' Shared localization helpers.
'
' Stroku's own chrome (navigation, Settings, the dialogs and status messages the
' app itself authors) is translated here. Everything an add-on returns - titles,
' descriptions, genres, add-on names, stream labels - is passed through
' untouched, because that text belongs to the add-on and not to Stroku.
'
' The active language is published on m.global the same way UiScale.brs publishes
' its scale factors, so components created long after MainScene (list and grid
' item components) read the same value without having to be told about it.
'
' Lookup rules, in order:
'   1. the string for the active language
'   2. the English string, when that language has no entry for the key
'   3. the key itself, when nothing has an entry
' A missing key therefore shows up as "settings.player.textSize" on screen rather
' than as a blank label, which is what makes it findable during testing.

function LocaleDefaultLanguage() as string
    return "English"
end function

' Canonical language identifiers. These are also the values written to the Roku
' registry, so they stay English regardless of what is on screen.
function LocaleLanguages() as object
    return ["English", "Spanish", "French", "German", "Italian", "Portuguese"]
end function

function LocaleIsKnownLanguage(language as string) as boolean
    for each candidate in LocaleLanguages()
        if candidate = language then return true
    end for
    return false
end function

' Publishes the active language so every component resolves the same table.
sub SetLocaleLanguage(language as string)
    resolved = language
    if not LocaleIsKnownLanguage(resolved) then resolved = LocaleDefaultLanguage()
    if m.global = invalid then return
    if not m.global.hasField("uiLanguage") then m.global.addField("uiLanguage", "string", false)
    m.global.setField("uiLanguage", resolved)
end sub

function LocaleLanguage() as string
    if m.global = invalid then return LocaleDefaultLanguage()
    if not m.global.hasField("uiLanguage") then return LocaleDefaultLanguage()
    value = m.global.uiLanguage
    if value = invalid or value = "" then return LocaleDefaultLanguage()
    if not LocaleIsKnownLanguage(value) then return LocaleDefaultLanguage()
    return value
end function

' The tables are literals, so they are built once per component scope and cached.
' Settings rebuilds roughly forty rows on every render and each row reads three
' strings, so rebuilding the table per lookup would be visible on a Roku.
function LocaleTable() as object
    if m.localeTable = invalid
        m.localeTable = {
            English: LocaleStringsEnglish()
            Spanish: LocaleStringsSpanish()
            French: LocaleStringsFrench()
            German: LocaleStringsGerman()
            Italian: LocaleStringsItalian()
            Portuguese: LocaleStringsPortuguese()
        }
    end if
    return m.localeTable
end function

function TrText(key as string) as string
    table = LocaleTable()

    entries = table[LocaleLanguage()]
    if entries <> invalid and entries.DoesExist(key)
        value = entries[key]
        if value <> invalid and value <> "" then return value
    end if

    fallback = table[LocaleDefaultLanguage()]
    if fallback <> invalid and fallback.DoesExist(key)
        value = fallback[key]
        if value <> invalid and value <> "" then return value
    end if

    return key
end function

' Single-placeholder substitution, for the few labels that splice a name or a
' query into a sentence. Word order differs per language, so the placeholder has
' to travel with the translated string rather than being concatenated in code.
function TrFormat(key as string, value as dynamic) as string
    text = TrText(key)
    replacement = ""
    if value <> invalid then replacement = value.ToStr()
    return LocaleReplace(text, "{0}", replacement)
end function

function LocaleReplace(text as string, token as string, replacement as string) as string
    position = Instr(1, text, token)
    if position <= 0 then return text
    return Left(text, position - 1) + replacement + Mid(text, position + Len(token))
end function

' Looks up a stored option value under a key prefix.
'
' Option values (subtitle size, colour, language names) stay canonical English in
' the registry so a language change never rewrites a preference. Only the display
' goes through here: TrOption("subtitle.size", "Medium") reads
' "subtitle.size.medium".
function TrOption(prefix as string, value as string) as string
    slug = LocaleSlug(value)
    if slug = "" then return value
    return TrText(prefix + "." + slug)
end function

' Lowercases and strips everything but letters and digits, so "Below video"
' becomes "belowvideo" and "75%" becomes "75".
function LocaleSlug(value as string) as string
    lowered = LCase(value)
    slug = ""
    for index = 1 to Len(lowered)
        character = Mid(lowered, index, 1)
        if (character >= "a" and character <= "z") or (character >= "0" and character <= "9")
            slug = slug + character
        end if
    end for
    return slug
end function

